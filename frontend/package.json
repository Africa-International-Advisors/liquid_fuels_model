{
  "name": "lfm-document-viewer",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "node --env-file-if-exists=.env.local scripts/start.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test lib/*.test.ts"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "lucide-react": "1.39.0",
    "radix-ui": "1.6.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.2",
    "@types/node": "22.17.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "tsx": "4.23.13"
  }
}
